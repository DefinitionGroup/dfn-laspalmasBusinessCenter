{
  "name": "las-palmas-business-center",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:seo": "node scripts/check-seo.mjs",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "sanity:check": "node --env-file-if-exists=.env.local scripts/check-sanity-env.mjs",
    "sanity:seed": "sanity exec scripts/seed-sanity.ts --with-user-token"
  },
  "dependencies": {
    "@portabletext/react": "^4.0.3",
    "@portabletext/types": "^2.0.15",
    "@sanity/client": "^7.12.1",
